# Copy this file to `.env` and change every secret before going online.
# Never commit `.env` or real passwords.

# runtime
NODE_ENV=development
PORT=3847
HOST=0.0.0.0

# SQLite location (use a persistent disk path in production, e.g. /var/data)
DATA_DIR=./data
# Exact SQLite file path (optional). Do not set a postgres:// URL.
# DATABASE_PATH=./data/officerflow.db
# DATABASE_URL=./data/officerflow.db

# Comma-separated frontend origins. Leave empty for same-origin production.
# Local Vite dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7
COOKIE_NAME=of_session
TRUST_PROXY=true
COOKIE_SECURE=false

# In production on Railway, leave COOKIE_SECURE unset so login cookies are marked Secure (HTTPS).

# Used only if the Admin username does not already exist (never overwrites officers or attendance).
# Do not put a Boss password here. Create Boss from Settings → User Management.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Admin

# Railway production only. On startup, if this is set, ONLY the admin password hash is updated.
# After you can sign in, delete this variable from the Railway dashboard.
# RESET_ADMIN_PASSWORD=

# Public website origin. Leave empty in production when the UI and API share one HTTPS URL.
# CORS_ORIGINS=https://officerflow-xxxxx.up.railway.app

# Frontend API URL. Leave empty to use the same origin `/api` (recommended).
# Never put secrets here — this value is visible in the browser build.
# VITE_API_URL=https://officerflow.example.com
VITE_API_URL=
