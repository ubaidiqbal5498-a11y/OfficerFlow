{
  "name": "officerflow",
  "version": "1.0.0",
  "private": true,
  "description": "Officer Management, Attendance, Salary and HR Record System",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev:client:install": "npm install --prefix client",
    "build": "npm run build --prefix client",
    "test": "node --test server/lib/loginSecurity.test.js server/lib/adminPasswordReset.test.js server/lib/paymentAccount.test.js",
    "start": "node server/index.js",
    "start:prod": "node server/index.js",
    "backup": "node server/scripts/backup.js",
    "set-admin-password": "node server/scripts/set-admin-password.js",
    "reset-admin-password": "node server/scripts/reset-production-admin-password.js",
    "postinstall": "npm install --prefix client --include=dev"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
